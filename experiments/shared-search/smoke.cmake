# The shared search against tables and journals the ordinary construction built.
#   cmake -DCLI=<carlobomb> -DSHARED=<shared_search> -DDIGEST=<nodes_digest> -DJOURNAL=<journal_digest>
#         -DWORK=<dir> -P smoke.cmake
function(run_ok)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "${ARGN}: exit ${code}\n${out}${err}")
  endif()
  set(last_output "${out}" PARENT_SCOPE)
endfunction()
function(run_fail)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(code EQUAL 0)
    message(FATAL_ERROR "${ARGN}: exit 0, a failure was expected\n${out}${err}")
  endif()
  set(last_output "${out}" PARENT_SCOPE)
endfunction()
function(expect text)
  if(NOT last_output MATCHES "${text}")
    message(FATAL_ERROR "output lacks '${text}'\n${last_output}")
  endif()
endfunction()
function(same_file a b)
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${a} ${b} RESULT_VARIABLE code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "${a} and ${b} differ")
  endif()
endfunction()
function(digest_of var)
  string(REGEX MATCH "index order\\):\n +([0-9a-f]+)" found "${last_output}")
  if(NOT CMAKE_MATCH_1)
    message(FATAL_ERROR "no digest in\n${last_output}")
  endif()
  set(${var} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

function(checksum_of var)
  string(REGEX MATCH "record checksum \\(every search: string, budget, result, steps\\): ([0-9a-f]+)" found "${last_output}")
  if(NOT CMAKE_MATCH_1)
    message(FATAL_ERROR "no record checksum in\n${last_output}")
  endif()
  set(${var} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

set(W ${WORK}/shared_search_test)
file(REMOVE_RECURSE ${W})
file(MAKE_DIRECTORY ${W})

# A 12-bit Bomb by search alone, from one node up: every REV in it is the first
# the LevelSolver finds at the string's minimum, which is what the shared search
# must find too.  All 2,048 strings that start with 0: the same node count, the
# same REV; and every REV runs on the reference interpreter.
run_ok(${CLI} bomb build --bits 12 --work-dir ${W}/d12 --enumerate-max 0 --workers 2 --progress 0 --quiet)
run_ok(${CLI} bomb finalize --work-dir ${W}/d12 --output ${W}/d12.frb)
run_ok(${SHARED} --bits 12 --check ${W}/d12.frb --expect 1:2,2:6,3:64,4:830,5:2994,6:200)
expect("2,048 strings found by search")
expect("unresolved [^:]*: 0")
expect("the histogram expected: every entry agrees")
expect("complement: 2,048 \\(2,048 from the search, 0 from the base\\)")
expect("the node count of the table for 2,048, another for 0")
expect("link for link and color for color, for 2,048 ")
digest_of(searched)
# The digest of what was found is the digest of what the Bomb says.
run_ok(${DIGEST} ${W}/d12.frb)
expect("1: 2  2: 6  3: 64  4: 830  5: 2,994  6: 200")
digest_of(stored)
if(NOT searched STREQUAL stored)
  message(FATAL_ERROR "digests differ: ${searched} found, ${stored} in the Bomb")
endif()
# The same in 16 classes and 3 processes: the outcome does not depend on either.
run_ok(${SHARED} --bits 12 --prefix-bits 5 --jobs 3 --check ${W}/d12.frb)
expect("in 16 classes of 16")
expect("the node count of the table for 2,048, another for 0")
expect("link for link and color for color, for 2,048 ")
digest_of(in_classes)
if(NOT searched STREQUAL in_classes)
  message(FATAL_ERROR "digests differ: ${searched} in one class, ${in_classes} in 16")
endif()
# A histogram that is not the Bomb's is noticed, and so is a budget too small to resolve every string.
run_fail(${SHARED} --bits 12 --expect 1:2,2:6,3:64,4:830,5:2996,6:198)
expect("NOT AS EXPECTED: 5 nodes: 2,994 strings, expected 2,996")
run_fail(${SHARED} --bits 12 --max-budget 5)
expect("unresolved [^:]*: 100")

# A level as the ladder builds it: on the Bomb one bit shorter.  The table the
# ladder wrote, entry for entry and then byte for byte; and the searches of the
# ladder's journal, every one with its result and its number of logical steps.
run_ok(${CLI} bomb ladder --dir ${W}/lad --from ${W}/d12.frb --to 13 --workers 2 --progress 0 --quiet)
run_ok(${SHARED} --bits 13 --prefix-bits 4 --jobs 2 --base ${W}/lad/fixed-run-12.frb --check ${W}/lad/fixed-run-13.frb
       --journal ${W}/lad/work-13 --out ${W}/t13.frb)
expect("2,048 settled by the REV of the base")
expect("unresolved [^:]*: 0")
expect("the node count of the table for 4,096, another for 0")
expect("link for link and color for color, for 4,096 ")
expect("every search of the journal: the same result, the same number of logical steps")
expect("complement: 4,096 \\(2,048 from the search, 2,048 from the base\\)")
same_file(${W}/t13.frb ${W}/lad/fixed-run-13.frb)
checksum_of(counted)
digest_of(level)
run_ok(${DIGEST} ${W}/lad/fixed-run-13.frb)
digest_of(stored)
if(NOT level STREQUAL stored)
  message(FATAL_ERROR "digests differ: ${level} found, ${stored} in the 13-bit Bomb")
endif()
# The journal read by itself gives the three numbers the shared search gave, and
# so does the shared search without the journal, cut into other classes.
run_ok(${JOURNAL} ${W}/lad/work-13)
checksum_of(journaled)
if(NOT counted STREQUAL journaled)
  message(FATAL_ERROR "record checksums differ: ${counted} counted, ${journaled} in the journal")
endif()
string(REGEX MATCH "searches: ([0-9,]+) [^\n]*, ([0-9,]+) logical steps" found "${last_output}")
set(searches "${CMAKE_MATCH_1}")
set(steps "${CMAKE_MATCH_2}")
string(REPLACE "," "" searches_plain "${searches}")
string(REPLACE "," "" steps_plain "${steps}")
run_ok(${SHARED} --bits 13 --prefix-bits 6 --jobs 3 --base ${W}/lad/fixed-run-12.frb --bound prefix
       --expect-totals ${searches_plain}:${steps_plain})
expect("total: ${searches} searches, ${steps} logical steps")
expect("both agree to the last digit")
expect("the last bits of the string, less one node, excludes: [1-9]")
checksum_of(counted)
if(NOT counted STREQUAL journaled)
  message(FATAL_ERROR "record checksums differ: ${counted} counted without the journal, ${journaled} in the journal")
endif()
math(EXPR one_more "${steps_plain} + 1")
run_fail(${SHARED} --bits 13 --base ${W}/lad/fixed-run-12.frb --bound prefix --expect-totals ${searches_plain}:${one_more})
expect("NOT the totals expected")

# Begun at a higher bound, each string is searched at fewer budgets and found
# at the same one: fewer searches, the same table.
run_ok(${SHARED} --bits 13 --prefix-bits 3 --base ${W}/lad/fixed-run-12.frb --bound suffix --count --out ${W}/u13.frb)
expect("from what its first and its last bits allow")
same_file(${W}/u13.frb ${W}/lad/fixed-run-13.frb)
run_ok(${SHARED} --bits 13 --prefix-bits 5 --jobs 2 --base ${W}/lad/fixed-run-12.frb --out ${W}/u13.frb)
expect("from what every stretch of it allows")
same_file(${W}/u13.frb ${W}/lad/fixed-run-13.frb)
# A Bomb answers shorter strings too: the 13-bit one has the digest of the 12-bit one in it.
run_ok(${DIGEST} ${W}/lad/fixed-run-13.frb --bits 12)
digest_of(shorter)
if(NOT shorter STREQUAL searched)
  message(FATAL_ERROR "digests differ: ${searched} for 12 bits, ${shorter} from the 13-bit Bomb")
endif()
